# Avalanche RPCs
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Deployment wallet. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# Optional verification
SNOWTRACE_API_KEY=

# ERC-4337 v0.7 singleton. Verified deployed on Avalanche C-Chain
# mainnet and used by the Coinbase/Base VerifyingPaymaster launch stack.
ENTRYPOINT_V07=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# SmoothSend-controlled signer used by the paymaster to approve sponsorship.
VERIFYING_SIGNER=

# Owner/admin multisig or deployer for contract administration.
OWNER=

# Optional: comma-separated bundler addresses to allowlist after deploy.
# UserOps can also set allowAnyBundler=true in paymaster data, so this can stay
# empty for the first smoke test.
BUNDLER_ADDRESSES=

# Initial paymaster deposit in AVAX, sent to EntryPoint.depositTo(paymaster).
INITIAL_PAYMASTER_DEPOSIT_AVAX=0
